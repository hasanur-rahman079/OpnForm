FROM node:24-alpine AS javascript-builder
WORKDIR /app

ARG NODE_MEMORY=8192

ADD ./client/package.json ./client/package-lock.json ./

RUN apk add --no-cache git

RUN npm cache clean --force && \
    rm -rf node_modules && \
    npm ci

RUN npm cache clean --force

ADD ./client/ /app/

ENV NODE_OPTIONS="--max-old-space-size=${NODE_MEMORY}"
ENV NODE_ENV=production
ENV NUXT_TELEMETRY_DISABLED=1

# Bypass package.json "build" script — it overrides NODE_OPTIONS with 8192.
# Call nuxt build directly so our memory limit takes effect.
RUN --mount=type=tmpfs,target=/tmp \
    NUXT_BUILD_CONCURRENCY=1 \
    npx nuxt build

FROM node:24-alpine
WORKDIR /app
COPY --from=javascript-builder /app/.output/ /app/
RUN ls /app/

CMD [ "node", "./server/index.mjs" ]
